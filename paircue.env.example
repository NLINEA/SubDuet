# Docker host settings. Keeping these here lets the recommended quick start use one config file.
MEDIA_PATH=/volume1/Media
TORRENT_WATCH_PATH=/volume1/Media/Torrents
PAIRCUE_PORT=9292
PUID=10001
PGID=10001

# Core subtitle service
# Platform: plex, jellyfin, emby, or filesystem
PAIRCUE_PLATFORM=plex
PAIRCUE_SERVER_URL=http://plex:32400
PAIRCUE_SERVER_TOKEN=replace-me
# Required for Jellyfin and Emby; leave empty for Plex or filesystem.
PAIRCUE_SERVER_USER_ID=
# Path seen by the media server. It maps to PAIRCUE_MEDIA_ROOT inside this container.
PAIRCUE_SERVER_PATH_PREFIX=/volume1/MediaForPlex
PAIRCUE_MEDIA_ROOT=/media
# Used only by filesystem mode.
PAIRCUE_FILESYSTEM_EXTENSIONS=.mkv,.mp4,.avi,.m4v,.mov,.ts,.webm
PAIRCUE_STATE_DIR=/state
PAIRCUE_SCAN_INTERVAL_SECONDS=1800

# Optional search/download through the official OpenSubtitles.com REST API only.
# Create an API consumer and key at https://www.opensubtitles.com/consumers
PAIRCUE_SUBTITLE_DOWNLOAD_ENABLED=true
PAIRCUE_OPENSUBTITLES_API_KEY=
# Account login is optional. If used, set both values; never commit them.
PAIRCUE_OPENSUBTITLES_USERNAME=
PAIRCUE_OPENSUBTITLES_PASSWORD=
PAIRCUE_SUBTITLE_DOWNLOAD_TIMEOUT_SECONDS=30

# Optional final fallback when no source subtitle exists. SubDuet extracts bounded FLAC chunks and
# sends their audio to this OpenAI-compatible transcription endpoint. Disabled by default.
PAIRCUE_TRANSCRIPTION_ENABLED=false
# Choose openai, custom, or local; verify the destination before adding your own key.
PAIRCUE_TRANSCRIPTION_PROVIDER=custom
PAIRCUE_TRANSCRIPTION_BASE_URL=
# Exact scheme + host + optional port (no path), e.g. https://api.openai.com
PAIRCUE_TRANSCRIPTION_APPROVED_ORIGIN=
PAIRCUE_TRANSCRIPTION_API_KEY=
PAIRCUE_TRANSCRIPTION_MODEL=whisper-1
PAIRCUE_TRANSCRIPTION_TIMEOUT_SECONDS=300
PAIRCUE_TRANSCRIPTION_MAX_ATTEMPTS=3
PAIRCUE_TRANSCRIPTION_CHUNK_SECONDS=300
# Optional vocabulary/context hint in the spoken source language.
PAIRCUE_TRANSCRIPTION_PROMPT=

# SubDuet's own conservative audio/subtitle alignment. It keeps the original on low confidence.
PAIRCUE_SYNC_ENABLED=true
PAIRCUE_SYNC_MAX_OFFSET_SECONDS=120
PAIRCUE_SYNC_MIN_CONFIDENCE=0.24
# Normally select by spoken-language metadata. If ambiguous, use an explicit global stream index
# for one video only; indexes can refer to different languages in different videos.
# PAIRCUE_AUDIO_STREAM_INDEX=1
# Safe default: align a temporary copy and leave the original subtitle untouched.
PAIRCUE_CLEAN_SOURCE_OUTPUT=false

# Language-learning pair (BCP-47). Names are optional for common languages.
PAIRCUE_SOURCE_LANGUAGE=en
PAIRCUE_SOURCE_LANGUAGE_NAME=
PAIRCUE_TARGET_LANGUAGE=zh-TW
PAIRCUE_TARGET_LANGUAGE_NAME=
PAIRCUE_TARGET_LANGUAGE_STYLE=natural, concise dialogue suitable for subtitles
# target-first puts the learning language above the source; source-first reverses the lines.
PAIRCUE_BILINGUAL_ORDER=target-first
# Two existing language files are merged by timing only above this confidence threshold.
PAIRCUE_BILINGUAL_MERGE_TOLERANCE_MS=350
PAIRCUE_BILINGUAL_MERGE_MIN_MATCH_RATIO=0.7

# Translation: explicitly choose your own OpenAI-compatible provider and model.
# No provider is preselected. Keep disabled when pairing two existing subtitle tracks.
PAIRCUE_TRANSLATION_ENABLED=false
# openai, zai, custom, or local. Named providers are restricted to their official API origin.
PAIRCUE_TRANSLATION_PROVIDER=custom
PAIRCUE_TRANSLATION_BASE_URL=
PAIRCUE_TRANSLATION_APPROVED_ORIGIN=
PAIRCUE_TRANSLATION_API_KEY=
PAIRCUE_TRANSLATION_MODEL=
PAIRCUE_TRANSLATION_DISABLE_THINKING=false
# Use the same provider for a second, fail-closed semantic review before files are saved.
PAIRCUE_TRANSLATION_FINAL_CHECK_ENABLED=true
PAIRCUE_FALLBACK_PROVIDER=custom
PAIRCUE_FALLBACK_BASE_URL=
PAIRCUE_FALLBACK_APPROVED_ORIGIN=
PAIRCUE_FALLBACK_API_KEY=
PAIRCUE_FALLBACK_MODEL=
PAIRCUE_FALLBACK_DISABLE_THINKING=false

# Polling works on every platform without an inbound port. Enable webhooks only when the media
# server or a trusted proxy can add SubDuet's Authorization: Bearer header.
PAIRCUE_WEBHOOK_ENABLED=false
PAIRCUE_API_HOST=0.0.0.0
PAIRCUE_API_PORT=9292
PAIRCUE_API_TOKEN=generate-with-paircue-generate-token
PAIRCUE_TRUSTED_HOSTS=localhost,127.0.0.1
